# ---- Sportsbook odds (the-odds-api.com). Free tier = 500 requests/month. ----
# Without a key the app falls back to ESPN's single consensus line.
ODDS_API_KEY=

# Comma-separated books to average for the "market consensus".
# Leave blank for "every book the API returns".
ODDS_BOOKS=draftkings,fanduel,betmgm,caesars,pointsbetus,williamhill_us,betrivers

# ---- Refresh intervals (seconds) ----
REFRESH_ODDS_SECONDS=900
REFRESH_SCORES_SECONDS=300
REFRESH_NEWS_SECONDS=900
REFRESH_STATS_SECONDS=21600

# Hard monthly ceiling on Odds API calls so the free tier is never blown.
ODDS_MONTHLY_BUDGET=480

# ---- Server ----
HOST=127.0.0.1
PORT=8000

# ---- Data ----
NFLPICKER_DATA_DIR=./data
NFLPICKER_SEASON=
# Set to 1 to run entirely on the built-in synthetic season (no network, no keys).
NFLPICKER_DEMO=0
# Demo only: pin how far the synthetic season has progressed (1-18).
# Leave blank to follow the calendar.
NFLPICKER_DEMO_WEEK=
